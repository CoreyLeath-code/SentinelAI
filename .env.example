# SentinelAI — Local Development Configuration
# Copy this file to .env and fill in required secrets before starting Compose.
# Run: cp .env.example .env
# Generate strong unique values (for example with: openssl rand -hex 24).
# Keep the .env file private; it is ignored by Git.

# ---------------------------------------------------------------------------
# Warehouse mode
# ---------------------------------------------------------------------------
# Use "postgres" for local development (default).
# Use "snowflake" to route writes/reads to a real Snowflake account.
WAREHOUSE_MODE=postgres

# ---------------------------------------------------------------------------
# Postgres (used when WAREHOUSE_MODE=postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel
# Set DATABASE_URL to postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable
# URL-encode password characters if needed.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Snowflake (used when WAREHOUSE_MODE=snowflake — leave blank for local dev)
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# ---------------------------------------------------------------------------
# AWS telemetry mirror (optional — disabled for local development)
# ---------------------------------------------------------------------------
# When enabled, accepted inference logs are queued and mirrored to Amazon Data
# Firehose. Use the AWS SDK default credential chain; prefer workload roles/IRSA
# in AWS instead of committing long-lived access keys.
FIREHOSE_ENABLED=false
FIREHOSE_DELIVERY_STREAM=sentinelai-telemetry
FIREHOSE_QUEUE_SIZE=1000
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# LLM / Ollama (optional — llm-guard falls back to stub if unreachable)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=llama2

# ---------------------------------------------------------------------------
# Inference API authentication
# ---------------------------------------------------------------------------
# Required to enable POST /infer and POST /predict. Use a unique local secret; do not commit it.
API_BEARER_TOKEN=

# Optional trained GPU/CPU inference checkpoint for POST /predict.
# Without BOTH an artifact path and its verified SHA-256, /predict returns 503
# rather than producing random-weight model outputs. Never commit checkpoints
# from untrusted sources or a real secret in this file.
SENTINEL_MODEL_CHECKPOINT=
SENTINEL_MODEL_SHA256=

# ---------------------------------------------------------------------------
# Internal service URLs
# ---------------------------------------------------------------------------
INGESTION_URL=http://ingestion-service:8080
DRIFT_ENGINE_URL=http://drift-engine:7070
LLM_GUARD_URL=http://llm-guard:8000

# Grafana administrator password (required)
GF_ADMIN_PASSWORD=

# Bind published ports to loopback by default. Public exposure requires
# suitable authentication, TLS, firewall controls, and explicit opt-in.
SENTINELAI_BIND_ADDRESS=127.0.0.1
